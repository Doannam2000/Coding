# Discord Bot Configuration
DISCORD_TOKEN=your_discord_token_here
CLIENT_ID=your_discord_client_id_here
GUILD_ID=your_discord_guild_id_here

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# AI Provider Keys
# ChatGPT Plus does NOT include API access.
# To use OpenAI models here, add a real OpenAI API key from platform.openai.com.
OPENAI_API_KEY=your_openai_api_key_here

# Owner Discord IDs (comma separated for multiple owners)
# Default: your_discord_user_id
OWNER_IDS=your_discord_user_id

# Security Settings
ENABLE_BLACKLIST=true
ENABLE_WHITELIST=false
WHITELISTED_COMMANDS=ls,dir,pwd,node,npm,yarn,git,cat,type

# Process Settings
PROCESS_TIMEOUT=300000
MAX_OUTPUT_LENGTH=4000
MAX_QUEUE_SIZE=5
COOLDOWN_MS=3000

# Shell Configuration
DEFAULT_SHELL=auto
MAX_HISTORY_PER_CHANNEL=50

# Logging
LOG_COMMANDS=true
LOG_FILE=./logs/commands.log

# Streaming + Watchdog Tuning
STREAM_FLUSH_INTERVAL_MS=800
STREAM_FLUSH_MAX_CHARS=3000
EVENT_LOOP_WATCHDOG_INTERVAL_MS=10000
EVENT_LOOP_LAG_WARN_MS=1500
