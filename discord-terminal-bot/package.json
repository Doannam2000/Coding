{
  "name": "discord-terminal-bot",
  "version": "1.0.0",
  "description": "Remote terminal bot for Discord with advanced CLI features",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "test:codex": "node test-codex-chat.js",
    "test:utf8": "node test-utf8-terminal.js",
    "start": "node dist/combined.js",
    "start:discord": "node dist/index.js",
    "dev": "ts-node src/combined.ts",
    "dev:discord": "ts-node src/index.ts",
    "pm2:start": "npm run build && pm2 start ecosystem.config.js",
    "pm2:reload": "npm run build && pm2 reload ecosystem.config.js",
    "pm2:logs": "pm2 logs discord-terminal-bot",
    "pm2:save": "pm2 save",
    "watchdog:check": "node scripts/watchdog.js",
    "lint": "eslint src/**/*.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "discord",
    "bot",
    "terminal",
    "cli",
    "discord.js"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "child_process": "^1.0.2",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.7",
    "node-pty": "^1.1.0",
    "node-telegram-bot-api": "^0.67.0",
    "os": "^0.1.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/node-telegram-bot-api": "^0.64.14",
    "@typescript-eslint/eslint-plugin": "^8.26.1",
    "@typescript-eslint/parser": "^8.26.1",
    "eslint": "^9.22.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
