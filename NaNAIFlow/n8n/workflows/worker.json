    },
    {
      "parameters": {
        "workflowId": "bot-notifier",
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
            "task_id": "={{$item(0).$node['Claim Step'].json.task_id}}",
            "step_no": "={{$item(0).$node['Claim Step'].json.step_no}}",
            "status": "={{$item(0).$node['Parse Run'].json.run_status}}",
