            "commit": "={{$item(0).$node['Parse Run'].json.commit}}",
            "changed_files": "={{$item(0).$node['Parse Run'].json.changed_files}}",
            "started_at": "={{$item(0).$node['Claim Step'].json.started_at}}",
            "finished_at": "={{new Date().toISOString()}}"
          }
        }
      },
      "id": "Notify",
      "name": "Notify",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.1,
      "position": [
        2660,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "update bot_tasks set status='completed', updated_at=now() where id=$1 and not exists (select 1 from bot_task_steps s where s.task_id=$1 and s.status in ('pending','running')) returning id;",
        "additionalFields": {
          "queryParams": "={{[$json.id]}}"
        }
      },
