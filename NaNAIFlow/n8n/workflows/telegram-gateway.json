    {
      "parameters": {
        "jsCode": "const command = $node['Parse Command'].json.command || 'command';\nconst row = $json || {};\nlet detail = '';\nif (row.id) {\n  detail = `id=${row.id}`;\n}\nif (row.status) {\n  detail = detail ? `${detail}, status=${row.status}` : `status=${row.status}`;\n}\nif (row.cron_expr) {\n  detail = detail ? `${detail}, cron=${row.cron_expr}` : `cron=${row.cron_expr}`;\n}\nif (row.key && row.value) {\n  detail = detail ? `${detail}, ${row.key}=${row.value}` : `${row.key}=${row.value}`;\n}\nif (row.config_md_path) {\n  detail = detail ? `${detail}, spec=${row.config_md_path}` : `spec=${row.config_md_path}`;\n}\nif (row.message) {\n  detail = detail ? `${detail}, message=${row.message}` : `message=${row.message}`;\n}\nreturn [{ text: detail ? `OK ${command}: ${detail}` : `OK ${command}` }];"
      },
